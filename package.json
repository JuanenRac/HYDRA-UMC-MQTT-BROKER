{
  "name": "hydra-umc-mqtt-broker",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "Lightweight MQTT 3.1.1 broker bridging HYDRA-UMC robot telemetry and commands to external IoT devices, dashboards and home-automation systems.",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "hash-password": "tsx src/hash-password.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "aedes": "^1.2.0",
    "bonjour-service": "^1.4.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "mqtt": "^5.16.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
