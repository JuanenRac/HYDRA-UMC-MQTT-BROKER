{
  "name": "hydra-umc-mqtt-broker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lightweight MQTT 3.1.1 broker bridging HYDRA-UMC robot telemetry and commands to external IoT devices, dashboards and home-automation systems.",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "aedes": "^1.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "mqtt": "^5.15.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
