# This service does not auto-load .env: export these values through systemd,
# Docker or the invoking shell. The broker listens on this TCP port. Default: 1883.
PORT=1883

# Real, opt-in topic ACL (see src/acl.ts) - a JSON array of
# {clientIdPrefix, publish: [...filters], subscribe: [...filters]} rules.
# Unset (the default) means every client can publish/subscribe anywhere,
# exactly as before this option existed. A malformed value fails startup
# loudly rather than silently running unprotected.
# MQTT_ACL_JSON=[{"clientIdPrefix":"robot-","publish":["hydra/robots/+/status"],"subscribe":["hydra/robots/+/command"]}]

# Real example scoping the 5 external machine bridges (see
# docs/BRIDGE_TOPICS.md) to their own hydra/bridges/<name>/# namespace -
# each bridge's own mqtt_transport.py connects with exactly one of these
# client ID prefixes (its run_forever()'s own default client_id):
# MQTT_ACL_JSON=[{"clientIdPrefix":"hydra-umc-bridge-cnc","publish":["hydra/bridges/cnc/#"],"subscribe":["hydra/bridges/cnc/cmd/#"]},{"clientIdPrefix":"hydra-umc-bridge-laser","publish":["hydra/bridges/laser/#"],"subscribe":["hydra/bridges/laser/cmd/#"]},{"clientIdPrefix":"hydra-umc-bridge-openpnp","publish":["hydra/bridges/openpnp/#"],"subscribe":["hydra/bridges/openpnp/cmd/#"]},{"clientIdPrefix":"hydra-umc-bridge-printer3d","publish":["hydra/bridges/printer3d/#"],"subscribe":["hydra/bridges/printer3d/cmd/#"]},{"clientIdPrefix":"hydra-umc-bridge-ros2","publish":["hydra/bridges/ros2/#"],"subscribe":["hydra/bridges/ros2/cmd/#"]}]

# Optional MQTT CONNECT authentication. Use a secret manager or your service
# manager's protected environment, never a committed .env file. Once set,
# every client must send one matching username/password pair before it can use
# the broker. Each credential's own clientIdPrefix is required and enforced:
# a client authenticating with this credential must declare a client ID
# starting with it, so a valid but lower-privilege credential cannot simply
# pick a different, more privileged client ID and inherit MQTT_ACL_JSON's
# permissions for it. Pair this with MQTT_ACL_JSON: an ACL alone trusts a
# client ID with no verification behind it at all.
# MQTT_AUTH_JSON=[{"username":"robot-1","password":"replace-with-a-secret","clientIdPrefix":"robot-"}]

# Real, opt-in payload size cap in bytes, enforced on every PUBLISH.
# Unset (the default) means unlimited, exactly as before this option existed.
# MAX_PAYLOAD_BYTES=65536

# Real, opt-in MQTT-over-WebSocket listener, alongside the plain-TCP one
# above - the SAME broker instance, same ACL/auth/payload-limit hooks.
# Unset (the default) starts no WS listener at all. 8083 matches the
# de facto convention among real brokers for plain (non-TLS) MQTT-over-WS.
# MQTT_WS_PORT=8083

# A production start (NODE_ENV=production, which the Dockerfile sets) refuses to run
# without MQTT_AUTH_JSON AND MQTT_ACL_JSON, with credential passwords of at least 16
# characters that are not examples, and with an ACL rule whose clientIdPrefix is a prefix
# of every credential's own clientIdPrefix. The ACL is evaluated against the credential's
# own clientIdPrefix (the identity it proved), not against the client ID the client chose.
# This says, on purpose, that the broker is an open lab broker (no credentials, no ACL):
# MQTT_ALLOW_ANONYMOUS=1

# The interface the MQTT (TCP and WebSocket) listeners bind to. Default: every interface.
# A deployment whose clients are all local sets 127.0.0.1.
# MQTT_BIND_HOST=0.0.0.0
# The interface of the metrics listener. Default: the same as MQTT_BIND_HOST.
# MQTT_METRICS_HOST=127.0.0.1

# Retained messages expire after this many milliseconds. Default: never, except that a
# production start applies 24 hours (86400000) when this is not set.
# MQTT_RETAINED_TTL_MS=86400000

